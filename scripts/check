#!/usr/bin/env bash
# Maya health checks. Run in full, every session, by the operator agent.
# One section per build phase; sections are added by the story that
# introduces the capability they test. See CLAUDE.md, "Definition of done".
#
# Usage: scripts/check [section]     (default: all)
set -uo pipefail

PASS=0; FAIL=0

# How long to let a container sit in `starting` before calling it a
# failure. LibreChat cold-starts in ~45s; this is comfortably past that
# without letting a genuinely stuck container hang the run.
HEALTH_WAIT="${HEALTH_WAIT:-90}"

# The context window Ollama is expected to load models at, set on the
# host as OLLAMA_CONTEXT_LENGTH. See docs/PHASES.md for what it costs.
NUM_CTX="${NUM_CTX:-32768}"

# Where Maya answers. From Phase 2 this is the tailnet MagicDNS name over
# HTTPS — LibreChat no longer publishes a port of its own, so there is no
# 127.0.0.1:3080 to fall back to.
MAYA_URL="${MAYA_URL:-https://madhu-m3-mpb.tailadf0a2.ts.net}"
ok()   { printf '  PASS  %s\n' "$1"; PASS=$((PASS+1)); }
bad()  { printf '  FAIL  %s\n' "$1"; FAIL=$((FAIL+1)); }
head_() { printf '\n== %s ==\n' "$1"; }

# ---------------------------------------------------------------- prereqs
check_prereqs() {
  head_ "Prerequisites"

  if command -v docker >/dev/null; then
    ok "docker present ($(docker --version))"
  else
    bad "docker not found"
  fi

  if docker info >/dev/null 2>&1; then
    ok "docker daemon reachable"
  else
    bad "docker daemon not reachable"
  fi

  if docker compose version >/dev/null 2>&1; then
    ok "compose present ($(docker compose version --short))"
  else
    bad "docker compose not available"
  fi

  if command -v ollama >/dev/null; then
    ok "ollama present ($(ollama --version 2>&1 | head -1))"
  else
    bad "ollama not found"
  fi

  local tags
  if tags=$(curl -fsS -m 5 http://localhost:11434/api/tags 2>/dev/null); then
    local n
    n=$(printf '%s' "$tags" | grep -o '"name"' | wc -l | tr -d ' ')
    ok "ollama API answering on 11434 ($n model(s))"
  else
    bad "ollama API not answering on http://localhost:11434/api/tags"
  fi

  if command -v gh >/dev/null && gh auth status >/dev/null 2>&1; then
    ok "gh authenticated"
  else
    bad "gh not authenticated (run: gh auth login)"
  fi
}

# --------------------------------------------------------------- phase 1
# Added by the Phase 1 stories. Still to cover:
#   - librechat and mongo containers healthy
#   - only 127.0.0.1-bound ports published
check_phase1() {
  head_ "Phase 1 — LibreChat + Ollama"

  # -- story #9, superseded by #23 ---------------------------------------
  # #9 asserted the opposite of what is here now. It assumed a
  # loopback-bound Ollama is unreachable from containers, and bound
  # 0.0.0.0 to fix it. On OrbStack that premise is false: container
  # traffic to host.docker.internal (0.250.250.254) arrives on the host
  # as 127.0.0.1 -> 127.0.0.1:11434, so loopback was always enough. What
  # matters for Phase 1 is reachability, asserted below and from inside
  # LibreChat further down; the bind *shape* is now a Phase 2 concern.
  local listen
  listen=$(lsof -nP -iTCP:11434 -sTCP:LISTEN 2>/dev/null | awk 'NR>1 {print $(NF-1)}' | tr '\n' ' ')
  if [ -n "${listen// /}" ]; then
    ok "ollama listening ($listen)"
  else
    bad "no listener on TCP 11434"
  fi

  # The check that actually catches the loopback bind: reach the host
  # from inside a container, the way every later phase will.
  local models n
  if models=$(docker run --rm curlimages/curl:latest -fsS -m 10 \
                http://host.docker.internal:11434/v1/models 2>/dev/null); then
    n=$(printf '%s' "$models" | grep -o '"id"' | wc -l | tr -d ' ')
    if [ "$n" -gt 0 ]; then
      ok "container -> host.docker.internal:11434/v1/models ($n model(s))"
    else
      bad "container reached 11434 but the model list came back empty"
    fi
  else
    bad "container cannot reach http://host.docker.internal:11434/v1/models"
  fi

  # -- story #12: context window -----------------------------------------
  # Ollama 0.32 loads a model at its full advertised context unless told
  # otherwise — 262144 and 46 GB for the 27B here — so this is pinned
  # deliberately rather than left to the default. launchctl setenv does
  # not survive a reboot, which is exactly the regression this catches.
  local ctx_env ctx_loaded
  ctx_env=$(launchctl getenv OLLAMA_CONTEXT_LENGTH 2>/dev/null)
  if [ "$ctx_env" = "$NUM_CTX" ]; then
    ok "OLLAMA_CONTEXT_LENGTH is $NUM_CTX"
  elif [ -z "$ctx_env" ]; then
    bad "OLLAMA_CONTEXT_LENGTH unset — models will load at their full context (46 GB for the 27B). Run: launchctl setenv OLLAMA_CONTEXT_LENGTH $NUM_CTX, then restart the Ollama app"
  else
    bad "OLLAMA_CONTEXT_LENGTH is '$ctx_env', expected '$NUM_CTX' (see docs/PHASES.md)"
  fi

  # The environment variable only takes effect on models loaded after the
  # Ollama app restarted, so check what is actually resident. Nothing
  # loaded is not a failure — models unload on idle.
  # Column offsets from the header, not field numbers: SIZE is "31 GB"
  # and UNTIL is "4 minutes from now", so $(NF-n) lands on a word of the
  # timestamp instead of the context.
  ctx_loaded=$(ollama ps 2>/dev/null \
    | awk 'NR==1{c=index($0,"CONTEXT"); next} NF && c {s=substr($0,c); split(s,a," "); print a[1]}' \
    | sort -u | tr '\n' ' ')
  if [ -z "${ctx_loaded// /}" ]; then
    ok "no model resident (nothing to check against $NUM_CTX)"
  elif [ "${ctx_loaded// /}" = "$NUM_CTX" ]; then
    ok "resident model(s) loaded at $NUM_CTX"
  else
    bad "resident model(s) at context '${ctx_loaded}', expected $NUM_CTX — Ollama was not restarted after the variable changed"
  fi

  # -- story #10: compose scaffold ---------------------------------------
  local cfg
  if cfg=$(docker compose --profile core config 2>&1 >/dev/null); then
    if [ -z "$cfg" ]; then
      ok "compose config parses clean (no warnings)"
    else
      bad "compose config warned: $(printf '%s' "$cfg" | tr '\n' ' ')"
    fi
  else
    bad "compose config failed: $(printf '%s' "$cfg" | tr '\n' ' ')"
  fi

  # Both core services running. Deliberately not "exactly these two":
  # `docker compose ps` lists every running container in the project
  # regardless of the --profile filter, so once Phase 2's edge is up this
  # would fail on Caddy's presence. What belongs to the edge is asserted
  # in check_phase2.
  local running missing
  running=$(docker compose --profile core ps --status running \
              --format '{{.Names}}' 2>/dev/null | awk 'NF' | sort | tr '\n' ' ')
  missing=""
  for c in maya-mongo maya-librechat; do
    case " $running " in *" $c "*) ;; *) missing="$missing $c" ;; esac
  done
  if [ -z "$missing" ]; then
    ok "core services running (${running% })"
  else
    bad "core services not running:$missing (scripts/maya up)"
  fi

  # Health, not just running — a container that is up but unhealthy is a
  # failure, and LibreChat answering /health is what the UI depends on.
  #
  # `starting` is not a verdict, it is the absence of one, so wait it out
  # rather than sampling once: the operator's procedure is `maya up` then
  # `check`, and LibreChat needs ~45s from cold. A check that cries wolf
  # on a healthy stack teaches everyone to re-run it and ignore the first
  # result, which is how a real failure gets waved through. `unhealthy`,
  # `none` and `missing` are terminal — those still FAIL immediately, and
  # so does a container still `starting` when the bound runs out.
  local st waited
  for c in maya-mongo maya-librechat; do
    waited=0
    while :; do
      st=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' \
             "$c" 2>/dev/null || echo missing)
      [ "$st" = starting ] || break
      [ "$waited" -ge "$HEALTH_WAIT" ] && break
      sleep 2
      waited=$((waited+2))
    done
    case "$st" in
      healthy)
        if [ "$waited" -gt 0 ]; then
          ok "$c healthy (after ${waited}s)"
        else
          ok "$c healthy"
        fi
        ;;
      starting)
        bad "$c still starting after ${waited}s (docker compose logs $c --tail 50)" ;;
      *)
        bad "$c health is '$st' (docker compose logs $c --tail 50)" ;;
    esac
  done

  # Publishing: LibreChat on 127.0.0.1 only, Mongo on nothing. A 0.0.0.0
  # bind here would put conversations on the LAN.
  local pubs
  pubs=$(docker compose --profile core ps --format '{{.Names}} {{.Publishers}}' 2>/dev/null)
  if printf '%s\n' "$pubs" | awk '/maya-mongo/ && /\{[0-9.]+ / {found=1} END {exit !found}'; then
    bad "maya-mongo publishes a host port: $(printf '%s' "$pubs" | tr '\n' ' ')"
  else
    ok "maya-mongo publishes nothing"
  fi
  # Phase 2 took publishing away from LibreChat and gave it to Caddy —
  # this asserted 127.0.0.1:3080 until then. The edge's own binding is
  # asserted in check_phase2.
  if printf '%s\n' "$pubs" | awk '/maya-librechat/ && /\{[0-9.]+ / {found=1} END {exit !found}'; then
    bad "maya-librechat publishes a host port: $(printf '%s' "$pubs" | tr '\n' ' ')"
  else
    ok "maya-librechat publishes nothing"
  fi
  if printf '%s\n' "$pubs" | awk '/\{0\.0\.0\.0 / {found=1} END {exit !found}'; then
    bad "a container publishes on 0.0.0.0: $(printf '%s' "$pubs" | tr '\n' ' ')"
  else
    ok "no container publishes on 0.0.0.0"
  fi

  # The UI itself, not just the container state — through the edge, since
  # that is now the only way in.
  if curl -fsS -m 10 -o /dev/null "$MAYA_URL/" 2>/dev/null; then
    ok "LibreChat UI answering at $MAYA_URL"
  else
    bad "LibreChat UI not answering at $MAYA_URL (is Tailscale up? is the edge profile running?)"
  fi

  # -- bug #32: every container can actually read its config --------------
  # `docker inspect` listing a mount proves nothing. A single-file bind
  # mount binds an inode, and git replaces inodes rather than editing in
  # place, so a checkout or pull silently detaches one — the running
  # container keeps serving from memory and only fails on its next
  # restart. Read the file from inside instead.
  local svc path unreadable=""
  for svc in \
    "maya-librechat:/app/librechat-config/librechat.yaml" \
    "maya-caddy:/etc/caddy/conf/Caddyfile" \
    "maya-litellm:/app/litellm-config/config.yaml"
  do
    path="${svc#*:}"
    docker exec "${svc%%:*}" sh -c "head -c1 '$path' >/dev/null 2>&1" 2>/dev/null \
      || unreadable="$unreadable ${svc%%:*}:$path"
  done
  if [ -z "$unreadable" ]; then
    ok "every container can read its own config file"
  else
    bad "container(s) cannot read their config:$unreadable (mount detached — scripts/maya up)"
  fi

  # -- story #11: Ollama endpoint ----------------------------------------
  # From inside LibreChat itself, over the exact URL its config uses. The
  # story-#9 check above proves a container can reach the host; this
  # proves *this* container can, with this baseURL. The image has no
  # curl, hence node.
  local lcmodels
  lcmodels=$(docker exec maya-librechat node -e \
    "fetch('http://host.docker.internal:11434/v1/models').then(r=>r.json()).then(j=>console.log((j.data||[]).map(m=>m.id).join(','))).catch(()=>process.exit(1))" \
    2>/dev/null)
  if [ -n "$lcmodels" ]; then
    ok "librechat -> host.docker.internal:11434/v1/models ($lcmodels)"
  else
    bad "librechat cannot reach http://host.docker.internal:11434/v1/models"
  fi

  # Model discovery, not a hand-maintained list. /api/models needs a
  # session, so assert the two things that produce the picker instead:
  # the endpoint is loaded with fetch on, and upstream offers more than
  # the one model named as the default. If both hold and the picker is
  # still short, the fault is in LibreChat, not in this config.
  local cfgfetch upstream_n
  # Comments stripped first — a commented-out `fetch: true` must not
  # satisfy this, and a bare regex over the file happily matches one.
  cfgfetch=$(docker exec maya-librechat node -e \
    "const y=require('fs').readFileSync('/app/librechat-config/librechat.yaml','utf8'); process.stdout.write(y.split('\n').map(l=>l.replace(/#.*\$/,'')).some(l=>/^\s*fetch:\s*true\s*\$/.test(l))?'yes':'no')" \
    2>/dev/null)
  upstream_n=$(printf '%s' "$lcmodels" | awk -F, 'NF{print NF}')
  if [ "$cfgfetch" = yes ] && [ "${upstream_n:-0}" -ge 2 ]; then
    ok "model discovery on: fetch: true, ${upstream_n} models upstream"
  elif [ "$cfgfetch" != yes ]; then
    bad "librechat.yaml is not mounted, or models.fetch is not true (models would have to be hand-listed)"
  else
    bad "only ${upstream_n:-0} model(s) upstream — discovery cannot be judged; check 'ollama list'"
  fi

}

# --------------------------------------------------------------- phase 2
# Added by the Phase 2 stories. Still to cover:
#   - caddy terminating TLS on the tailnet address
#   - the MagicDNS URL loading from a second device
check_phase2() {
  head_ "Phase 2 — Remote access"

  # -- story #21: tailnet TLS certificate ---------------------------------
  # Tailscale issues for 90 days. Our copy is a static file — nothing
  # renews it on its own — so this is the reminder, with enough runway to
  # act on it.
  local ts_bin domain crt
  ts_bin="${TAILSCALE_BIN:-/Applications/Tailscale.app/Contents/MacOS/Tailscale}"
  if [ ! -x "$ts_bin" ]; then
    bad "tailscale CLI not found at $ts_bin"
  else
    domain=$("$ts_bin" status --json 2>/dev/null \
      | python3 -c 'import sys,json; d=json.load(sys.stdin).get("CertDomains") or [""]; print(d[0])' 2>/dev/null)
    if [ -z "$domain" ]; then
      bad "tailnet has no cert domain — enable HTTPS Certificates at https://login.tailscale.com/admin/dns"
    else
      crt="data/tailscale/$domain.crt"
      if [ ! -f "$crt" ]; then
        bad "no certificate at $crt — run scripts/tailscale-cert"
      elif ! openssl x509 -in "$crt" -noout -checkend 1209600 >/dev/null 2>&1; then
        bad "certificate for $domain expires within 14 days ($(openssl x509 -in "$crt" -noout -enddate | cut -d= -f2)) — run scripts/tailscale-cert"
      else
        ok "tailnet certificate valid until $(openssl x509 -in "$crt" -noout -enddate | cut -d= -f2)"
      fi
    fi
  fi

  # -- story #22: the edge ------------------------------------------------
  # Exactly one service publishes, on the tailnet address, and nothing on
  # 0.0.0.0 or the LAN address. This is the assertion that keeps Maya off
  # every network but the tailnet.
  local epubs ts_ip lan_ip
  epubs=$(docker compose --profile core --profile edge ps --format '{{.Names}} {{.Publishers}}' 2>/dev/null)
  ts_ip=$(tailscale ip -4 2>/dev/null | head -1)
  if [ -z "$ts_ip" ]; then
    bad "no tailscale IPv4 address — is Tailscale running?"
  elif printf '%s\n' "$epubs" | awk -v ip="$ts_ip" '$0 ~ "maya-caddy" && index($0, "{" ip " 443 443") {found=1} END {exit !found}'; then
    ok "maya-caddy publishes $ts_ip:443 only"
  else
    bad "maya-caddy is not publishing on $ts_ip:443: $(printf '%s' "$epubs" | tr '\n' ' ')"
  fi

  # The edge answering over TLS with a certificate curl itself accepts —
  # not just a listener on the port.
  if curl -fsS -m 15 -o /dev/null "$MAYA_URL/" 2>/dev/null; then
    ok "edge serves $MAYA_URL with a trusted certificate"
  else
    bad "edge not serving $MAYA_URL (or the certificate is not trusted)"
  fi

  # The LAN must get nothing at all — neither the old LibreChat port nor
  # the edge's.
  lan_ip=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || true)
  if [ -z "$lan_ip" ]; then
    ok "no LAN address to test the edge against (offline)"
  else
    local leaked=""
    curl -fsS -m 5 -o /dev/null "http://$lan_ip:3080/" 2>/dev/null && leaked="$leaked $lan_ip:3080"
    curl -fsSk -m 5 -o /dev/null "https://$lan_ip:443/" 2>/dev/null && leaked="$leaked $lan_ip:443"
    if [ -n "$leaked" ]; then
      bad "reachable from the LAN on:$leaked"
    else
      ok "nothing answers on the LAN address ($lan_ip:3080, :443)"
    fi
  fi

  # -- story #15: registration closed ------------------------------------
  # Asserted against the running container, not against .env: `docker
  # compose restart` reuses the old environment, so .env can read
  # ALLOW_REGISTRATION=false while the container still has true. That
  # failure is silent — this check is what catches it.
  local probe code
  probe="maya-check-probe@invalid.test"
  code=$(curl -sS -m 15 -o /dev/null -w '%{http_code}' \
           -X POST "$MAYA_URL/api/auth/register" \
           -H 'Content-Type: application/json' \
           -d "{\"name\":\"Maya Check\",\"username\":\"mayacheckprobe\",\"email\":\"$probe\",\"password\":\"Nx7!probe-pass-42\",\"confirm_password\":\"Nx7!probe-pass-42\"}" \
           2>/dev/null || echo 000)
  case "$code" in
    2*)
      # Registration was open after all, so the probe just created a
      # user. Remove it rather than leaving the row behind.
      docker exec maya-mongo mongosh --quiet LibreChat \
        --eval "db.users.deleteOne({email:'$probe'})" >/dev/null 2>&1
      bad "registration is OPEN (POST /api/auth/register -> $code); probe user removed. Set ALLOW_REGISTRATION=false in .env and run 'scripts/maya up' — not 'restart'"
      ;;
    000)
      bad "registration probe got no response from $MAYA_URL/api/auth/register"
      ;;
    *)
      ok "registration refused (POST /api/auth/register -> $code)"
      ;;
  esac

  # -- story #23: Ollama not reachable off this host ----------------------
  # #9 opened 11434 to the LAN, knowingly. It turned out to be
  # unnecessary — see the note in check_phase1 — so the exposure is
  # closed rather than narrowed. Anything but loopback here means the
  # models are answering to something other than this machine.
  local listen offhost
  listen=$(lsof -nP -iTCP:11434 -sTCP:LISTEN 2>/dev/null | awk 'NR>1 {print $(NF-1)}')
  offhost=$(printf '%s\n' "$listen" \
    | awk 'NF && $0 !~ /^127\.0\.0\.1:/ && $0 !~ /^\[::1\]:/' | tr '\n' ' ')
  if [ -z "${listen// /}" ]; then
    bad "no listener on TCP 11434"
  elif [ -z "${offhost// /}" ]; then
    ok "ollama bound to loopback only ($(printf '%s' "$listen" | tr '\n' ' '))"
  else
    bad "ollama reachable beyond this host on $offhost — run scripts/install-host-env and restart Ollama"
  fi

  # Belt and braces: the bind shape says what should happen, this says
  # what does. A LAN address that answers is the failure #23 exists to
  # prevent.
  local lan
  lan=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || true)
  if [ -z "$lan" ]; then
    ok "no LAN address to test against (offline)"
  elif curl -fsS -m 5 -o /dev/null "http://$lan:11434/api/tags" 2>/dev/null; then
    bad "ollama answers on the LAN address $lan:11434 — the models are open to this network"
  else
    ok "ollama refuses connections on the LAN address ($lan:11434)"
  fi

  # -- story #23: host settings survive a reboot --------------------------
  # launchctl setenv is lost on reboot, and Ollama reads its environment
  # at launch, so a revert is silent: 46 GB resident instead of 31 GB,
  # with nothing to announce it.
  # -- bug #31: the model stays resident ----------------------------------
  # Default unloads after five minutes idle; reloading the 27B reads
  # 31 GB back — seconds from the page cache, minutes from SSD, with no
  # progress shown either way. -1 keeps it loaded at a standing cost of
  # 31 GB.
  local keep
  keep=$(launchctl getenv OLLAMA_KEEP_ALIVE 2>/dev/null)
  if [ "$keep" = "-1" ]; then
    ok "OLLAMA_KEEP_ALIVE is -1 (models stay resident)"
  elif [ -z "$keep" ]; then
    bad "OLLAMA_KEEP_ALIVE unset — the model unloads after 5 minutes idle and the next message stalls. Run scripts/install-host-env and restart Ollama"
  else
    bad "OLLAMA_KEEP_ALIVE is '$keep', expected '-1' (see docs/PHASES.md)"
  fi

  local label agent
  label="com.maya.ollama-env"
  agent="$HOME/Library/LaunchAgents/$label.plist"
  if [ ! -f "$agent" ]; then
    bad "$label is not installed — run scripts/install-host-env"
  elif launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1; then
    ok "$label installed and loaded"
  else
    bad "$label exists at $agent but is not loaded — run scripts/install-host-env"
  fi
}

# --------------------------------------------------------------- phase 3
check_phase3() {
  head_ "Phase 3 — LiteLLM gateway"

  # -- story #27: the gateway ---------------------------------------------
  local key aliases want
  key=$(awk -F= '/^LITELLM_MASTER_KEY=/{sub(/^[^=]*=/,""); print; exit}' .env 2>/dev/null)
  if [ -z "$key" ]; then
    bad "LITELLM_MASTER_KEY not set in .env"
    return
  fi

  # From a container on maya-internal, the way every consumer reaches it —
  # there is no host port to curl.
  aliases=$(docker run --rm --network maya-internal curlimages/curl:latest -sS -m 20 \
              -H "Authorization: Bearer $key" http://maya-litellm:4000/v1/models 2>/dev/null \
            | python3 -c 'import sys,json; print(",".join(sorted(m["id"] for m in json.load(sys.stdin)["data"])))' 2>/dev/null)
  want="coding,fast,general,reasoning"
  if [ -z "$aliases" ]; then
    bad "LiteLLM did not answer /v1/models on maya-internal (scripts/maya up)"
  elif [ "$aliases" = "$want" ]; then
    ok "gateway serves exactly the four aliases ($aliases)"
  else
    bad "gateway aliases are '$aliases', expected '$want'"
  fi

  # -- story #28: no concrete model name outside the gateway config -------
  # The names are read out of config/litellm/config.yaml rather than
  # hard-coded here, so this keeps working when the models change — and
  # it fails the moment a name leaks back into a caller.
  #
  # Scoped to configuration and code. docs/ legitimately names models
  # when recording what was measured: a build log that cannot say which
  # model took 46 GB is worth less than one that can.
  local names leaks
  names=$(awk '/^ *model: /{sub(/^ *model: */,""); sub(/^[a-z_]*\//,""); print}' \
            config/litellm/config.yaml 2>/dev/null | sort -u)
  if [ -z "$names" ]; then
    bad "could not read model names from config/litellm/config.yaml"
  else
    leaks=""
    while IFS= read -r n; do
      [ -z "$n" ] && continue
      local hits
      hits=$(grep -rlF "$n" config scripts compose.yaml .env.example 2>/dev/null \
             | grep -v '^config/litellm/config.yaml$' | tr '\n' ' ')
      [ -n "${hits// /}" ] && leaks="$leaks $n->[${hits% }]"
    done <<< "$names"
    if [ -z "$leaks" ]; then
      ok "no concrete model name outside config/litellm/config.yaml ($(printf '%s' "$names" | tr '\n' ' '))"
    else
      bad "concrete model name(s) leaked outside the gateway config:$leaks"
    fi
  fi

  local pubs
  pubs=$(docker compose --profile gateway ps --format '{{.Names}} {{.Publishers}}' 2>/dev/null | awk '/maya-litellm/')
  if printf '%s\n' "$pubs" | awk '/\{[0-9.]+ / {found=1} END {exit !found}'; then
    bad "maya-litellm publishes a host port: $pubs"
  else
    ok "maya-litellm publishes nothing"
  fi
}

# --------------------------------------------------------------- phase 4
check_phase4() {
  head_ "Phase 4 — MCP and filesystem"

  # -- story #35: the MCP loop --------------------------------------------
  # Ask the server itself what it advertises, rather than reading
  # LibreChat's startup log. A server that starts but advertises nothing
  # looks identical, from the model's side, to one that is not there.
  local tools
  tools=$(docker exec -i maya-librechat python3 - \
            uvx mcp-server-time --local-timezone=America/Los_Angeles \
            < scripts/lib/mcp-probe.py 2>/dev/null | tr -d '\r')
  if [ -n "$tools" ]; then
    ok "MCP time server advertises tools ($tools)"
  else
    bad "MCP time server advertised no tools (docker compose logs librechat | grep MCP)"
  fi

  # -- bug #43: the tools are actually offered -----------------------------
  # Servers advertising tools is not the same as the model being given
  # them. LibreChat arms MCP tools only through an agent, so this asserts
  # the whole chain: an agent id is configured, that agent exists, it
  # carries MCP tools, and a default spec points new conversations at it.
  local agent_id agent_tools spec
  agent_id=$(awk -F= '/^MAYA_AGENT_ID=/{sub(/^[^=]*=/,""); print; exit}' .env 2>/dev/null)
  if [ -z "$agent_id" ]; then
    bad "MAYA_AGENT_ID not set in .env — new conversations get no tools (see docs/PHASES.md, bug #43)"
  else
    agent_tools=$(docker exec maya-mongo mongosh --quiet LibreChat --eval \
      "const a=db.agents.findOne({id:'$agent_id'}); print(a ? (a.tools||[]).filter(t=>/_mcp_/.test(t)).length : -1)" 2>/dev/null | tr -d '\r')
    case "$agent_tools" in
      -1|"") bad "no agent '$agent_id' in the database — create it in the UI and update MAYA_AGENT_ID" ;;
      0)     bad "agent '$agent_id' carries no MCP tools — attach them in the Agent Builder" ;;
      *)     ok "default agent carries $agent_tools MCP tools" ;;
    esac
    spec=$(docker exec maya-librechat sh -c \
      "grep -A6 'modelSpecs:' /app/librechat-config/librechat.yaml | grep -c 'default: true'" 2>/dev/null | tr -d '\r')
    if [ "${spec:-0}" -gt 0 ]; then
      ok "a default modelSpec pins new conversations to the agent"
    else
      bad "no default modelSpec — new conversations will open without tools"
    fi
  fi

  # -- story #36: the filesystem boundaries --------------------------------
  local FS_CMD="npx -y @modelcontextprotocol/server-filesystem /documents /projects"

  # A refused write, proven by attempting one. The mount saying `ro` and
  # the server refusing are two different claims; this tests the second,
  # and the host is checked afterwards in case both were wrong.
  local w
  w=$(docker exec -i maya-librechat python3 - \
        write_file '{"path":"/documents/maya-check-probe.txt","content":"x"}' \
        -- $FS_CMD < scripts/lib/mcp-call.py 2>/dev/null)
  if printf '%s' "$w" | grep -q '^ERROR'; then
    ok "write to /documents refused ($(printf '%s' "$w" | sed -n 's/.*"text": "\([^"]*\)".*/\1/p' | head -c 60))"
  else
    bad "write to /documents was NOT refused: $(printf '%s' "$w" | head -c 120)"
  fi
  if [ -e "$HOME/Documents/maya-check-probe.txt" ]; then
    bad "the probe file reached $HOME/Documents — /documents is writable"
    rm -f "$HOME/Documents/maya-check-probe.txt"
  fi

  # Nothing outside the two mounts, including via traversal.
  local esc
  esc=$(docker exec -i maya-librechat python3 - \
          read_text_file '{"path":"/documents/../etc/passwd"}' \
          -- $FS_CMD < scripts/lib/mcp-call.py 2>/dev/null)
  if printf '%s' "$esc" | grep -q '^ERROR'; then
    ok "path traversal out of /documents refused"
  else
    bad "path traversal escaped the mount: $(printf '%s' "$esc" | head -c 120)"
  fi

  # Mount hygiene across every container, not just the one with the tool.
  local bad_mounts="" c src dst
  for c in maya-librechat maya-caddy maya-litellm maya-mongo; do
    while IFS='|' read -r src dst; do
      [ -z "$src" ] && continue
      case "$src" in
        /var/run/docker.sock|/) bad_mounts="$bad_mounts $c:$src" ;;
        "$HOME")                bad_mounts="$bad_mounts $c:$src" ;;
      esac
    done <<< "$(docker inspect "$c" -f '{{range .Mounts}}{{.Source}}|{{.Destination}}{{"\n"}}{{end}}' 2>/dev/null)"
  done
  if [ -z "$bad_mounts" ]; then
    ok "no container mounts the home directory, host root, or Docker socket"
  else
    bad "forbidden mount(s):$bad_mounts"
  fi

  # -- story #37: the asymmetry -------------------------------------------
  # /documents read-only, /projects writable — and both asserted, so a
  # change that widens either fails the run rather than being noticed
  # later by its consequences.
  local docro projrw
  docro=$(docker inspect maya-librechat \
            -f '{{range .Mounts}}{{if eq .Destination "/documents"}}{{.RW}}{{end}}{{end}}' 2>/dev/null)
  projrw=$(docker inspect maya-librechat \
            -f '{{range .Mounts}}{{if eq .Destination "/projects"}}{{.RW}}{{end}}{{end}}' 2>/dev/null)
  if [ "$docro" = false ] && [ "$projrw" = true ]; then
    ok "/documents read-only, /projects writable"
  else
    bad "mount modes wrong: /documents RW=$docro (want false), /projects RW=$projrw (want true)"
  fi

  # The write actually reaching the host, not just the server saying so.
  local probe_rel="maya/data/maya-check-write-probe.txt"
  docker exec -i maya-librechat python3 - \
    write_file "{\"path\":\"/projects/$probe_rel\",\"content\":\"maya-check\"}" \
    -- $FS_CMD < scripts/lib/mcp-call.py >/dev/null 2>&1
  if [ -f "$HOME/Dev/$probe_rel" ]; then
    ok "write to /projects lands on the host"
    rm -f "$HOME/Dev/$probe_rel"
  else
    bad "write to /projects did not reach $HOME/Dev/$probe_rel"
  fi

  # -- story #38: document extraction --------------------------------------
  # Fixtures are committed rather than picked from Documents, so this
  # asserts on a known string and does not depend on what happens to be
  # on the owner's disk.
  local EX_CMD="uvx --with pypdf --with python-docx --with openpyxl python /app/mcp/extract/server.py"
  local MARK="MAYA-FIXTURE-MARKER-7412"
  local fx out missed=""
  for fx in sample.pdf sample.docx sample.xlsx; do
    out=$(docker exec -i maya-librechat python3 - \
            extract_document "{\"path\":\"/projects/maya/docs/fixtures/$fx\"}" \
            -- $EX_CMD < scripts/lib/mcp-call.py 2>/dev/null)
    printf '%s' "$out" | grep -q "$MARK" || missed="$missed $fx"
  done
  if [ -z "$missed" ]; then
    ok "extraction reads pdf, docx and xlsx"
  else
    bad "extraction failed for:$missed (expected the fixture marker)"
  fi

  # The extractor has its own file access, so it needs its own boundary.
  local esc2
  esc2=$(docker exec -i maya-librechat python3 - \
           extract_document '{"path":"/documents/../etc/passwd"}' \
           -- $EX_CMD < scripts/lib/mcp-call.py 2>/dev/null)
  if printf '%s' "$esc2" | grep -q '^ERROR'; then
    ok "extraction refuses paths outside /documents and /projects"
  else
    bad "extraction escaped the allowed roots: $(printf '%s' "$esc2" | head -c 120)"
  fi
}

# --------------------------------------------------------------- phase 5
check_phase5() {
  head_ "Phase 5 — Search and fetch"

  # -- story #45: SearXNG --------------------------------------------------
  # JSON, not HTML: stock SearXNG serves only HTML, which a tool cannot
  # parse. Reached the way the tool reaches it, from maya-internal.
  # Two things, separately: that SearXNG answers in JSON at all, and that
  # something upstream actually replied. The second depends on public
  # engines that rate-limit and serve CAPTCHAs under repeated automated
  # queries and recover on their own — so when it fails, say which
  # engines and why, rather than leaving someone to guess at the config.
  local sx
  sx=$(docker run --rm --network maya-internal curlimages/curl:latest -sS -m 90 \
        "http://maya-searxng:8080/search?q=apple+m3+max&format=json" 2>/dev/null)
  if [ -z "$sx" ]; then
    bad "searxng did not answer on maya-internal (scripts/maya up)"
  elif ! printf '%s' "$sx" | python3 -c 'import sys,json;json.load(sys.stdin)' 2>/dev/null; then
    bad "searxng did not return JSON — is json in search.formats? (config/searxng/settings.yml)"
  else
    local n why
    n=$(printf '%s' "$sx" | python3 -c 'import sys,json;print(len(json.load(sys.stdin).get("results",[])))')
    if [ "${n:-0}" -gt 0 ]; then
      ok "searxng returns JSON results ($n)"
    else
      why=$(printf '%s' "$sx" | python3 -c 'import sys,json;print("; ".join("%s: %s"%(e[0],e[1]) for e in json.load(sys.stdin).get("unresponsive_engines",[])[:6]) or "no reason given")')
      bad "searxng answered but every engine came back empty — $why"
    fi
  fi

  # -- story #46: the two tools --------------------------------------------
  # Exercised in-process rather than through the MCP wrapper: this is
  # about extraction quality, and the transport is already covered.
  local web
  web=$(docker exec maya-librechat sh -c 'uvx --with readability-lxml --with lxml_html_clean --with beautifulsoup4 python - <<'"'"'PYEOF'"'"'
import sys, re, json
sys.path.insert(0, "/app/mcp/web")
import server
out = {}
try:
    s = server.web_search("apple m3 max memory bandwidth", 3)
    out["search_results"] = s.count("http")
except Exception as e:
    out["search_error"] = "%s: %s" % (type(e).__name__, e)
try:
    t = server.web_fetch("https://en.wikipedia.org/wiki/Apple_M3")
    out["fetch_chars"] = len(t)
    out["fetch_html"] = bool(re.search(r"<(p|div|span|script|a|li)\b", t))
    out["fetch_navbox"] = "Cortex-A5" in t[:400]
except Exception as e:
    out["fetch_error"] = "%s: %s" % (type(e).__name__, e)
try:
    big = server.web_fetch("https://en.wikipedia.org/wiki/World_War_II")
    out["cap_ok"] = len(big) <= server.MAX_CHARS + 400 and "[truncated at" in big
except Exception as e:
    out["cap_error"] = "%s: %s" % (type(e).__name__, e)
print(json.dumps(out))
PYEOF' 2>/dev/null | tail -1)

  if [ -z "$web" ]; then
    bad "web tools produced no output (is the web profile up?)"
  else
    local verdicts
    verdicts=$(printf '%s' "$web" | python3 -c '
import sys, json
d = json.load(sys.stdin)
ok, bad_ = [], []
(ok if d.get("search_results", 0) > 0 else bad_).append("web_search returns URLs")
(ok if d.get("fetch_chars", 0) > 500 and not d.get("fetch_html") and not d.get("fetch_navbox")
   else bad_).append("web_fetch returns clean article text")
(ok if d.get("cap_ok") else bad_).append("web_fetch truncates a very large page")
for m in ok:  print("OK|" + m)
for m in bad_: print("BAD|" + m + " " + json.dumps(d))
' 2>/dev/null)
    # Here-string, not a pipe: a `while read` on the right of a pipe runs
    # in a subshell, so ok/bad increment counters that are thrown away —
    # the assertions print and the run still reports success.
    while IFS='|' read -r verdict msg; do
      [ -z "$verdict" ] && continue
      if [ "$verdict" = OK ]; then ok "$msg"; else bad "$msg"; fi
    done <<< "$verdicts"
  fi

  local spubs
  spubs=$(docker compose --profile web ps --format '{{.Names}} {{.Publishers}}' 2>/dev/null | awk '/maya-searxng/')
  if printf '%s\n' "$spubs" | awk '/\{[0-9.]+ / {found=1} END {exit !found}'; then
    bad "maya-searxng publishes a host port: $spubs"
  else
    ok "maya-searxng publishes nothing"
  fi
}

# --------------------------------------------------------------- phase 6
check_phase6() {
  head_ "Phase 6 — Browser"

  # -- story #49: the browser is contained --------------------------------
  # This is the one service that runs untrusted content by design, so the
  # mount and port assertions matter more here than anywhere else.
  local bmounts bpubs
  bmounts=$(docker inspect maya-browser \
    -f '{{range .Mounts}}{{.Source}}->{{.Destination}} {{end}}' 2>/dev/null)
  case "$bmounts" in
    *"$HOME/Documents"*|*"$HOME/Dev"*|*/var/run/docker.sock*)
      bad "browser has host mounts it must not have: $bmounts" ;;
    *)
      ok "browser has no host filesystem mounts${bmounts:+ beyond its own volume}" ;;
  esac

  bpubs=$(docker compose --profile browser ps --format '{{.Names}} {{.Publishers}}' 2>/dev/null | awk '/maya-browser/')
  if printf '%s\n' "$bpubs" | awk '/\{[0-9.]+ / {found=1} END {exit !found}'; then
    bad "maya-browser publishes a host port: $bpubs"
  else
    ok "maya-browser publishes nothing"
  fi

  # It renders. A browser that connects but cannot open a page is the
  # failure mode here — the container reported healthy for a full build
  # while Chromium was the wrong revision.
  local nav
  nav=$(docker exec -i maya-librechat python3 - \
          http://maya-browser:8931/mcp browser_navigate '{"url":"https://example.com"}' \
          < scripts/lib/mcp-http-call.py 2>/dev/null | head -c 400)
  if printf '%s' "$nav" | grep -q '^OK'; then
    ok "browser navigates and returns a page snapshot"
  else
    bad "browser could not navigate: $(printf '%s' "$nav" | head -c 160)"
  fi
}

# --------------------------------------------------------------- phase 7
check_phase7() {
  head_ "Phase 7 — Coding agent"

  # -- story #51: the agent is confined ------------------------------------
  # It edits files and runs commands, so its reach is exactly what it can
  # see. Assert what must NOT be there, not just what must.
  local reach
  reach=$(docker exec maya-coding sh -c \
    'for p in /documents /projects /var/run/docker.sock "$HOME/.ssh"; do [ -e "$p" ] && echo "$p"; done' 2>/dev/null | tr '\n' ' ')
  if [ -z "${reach// /}" ]; then
    ok "coding agent sees no mounts beyond its repository"
  else
    bad "coding agent can reach:$reach"
  fi

  local cmounts cpubs
  cmounts=$(docker inspect maya-coding -f '{{range .Mounts}}{{.Destination}} {{end}}' 2>/dev/null | tr -s ' ')
  if [ "${cmounts// /}" = "/repo" ]; then
    ok "coding agent has exactly one mount (/repo)"
  else
    bad "coding agent mounts more than its repository: $cmounts"
  fi

  cpubs=$(docker compose --profile coding ps --format '{{.Names}} {{.Publishers}}' 2>/dev/null | awk '/maya-coding/')
  if printf '%s\n' "$cpubs" | awk '/\{[0-9.]+ / {found=1} END {exit !found}'; then
    bad "maya-coding publishes a host port: $cpubs"
  else
    ok "maya-coding publishes nothing"
  fi

  # -- story #52: coding and general are different models -------------------
  # The alias existing is not the same as it resolving somewhere useful.
  local cmodel gmodel
  cmodel=$(awk '/model_name: coding/{f=1} f&&/^ *model: /{sub(/^ *model: */,"");print;exit}' config/litellm/config.yaml 2>/dev/null)
  gmodel=$(awk '/model_name: general/{f=1} f&&/^ *model: /{sub(/^ *model: */,"");print;exit}' config/litellm/config.yaml 2>/dev/null)
  if [ -z "$cmodel" ] || [ -z "$gmodel" ]; then
    bad "could not read the coding/general aliases from config/litellm/config.yaml"
  elif [ "$cmodel" = "$gmodel" ]; then
    bad "coding and general resolve to the same model ($cmodel) — the alias is not specialised"
  else
    ok "coding and general resolve to different models"
  fi
}

# ------------------------------------------------------------------- main
section="${1:-all}"
case "$section" in
  prereqs) check_prereqs ;;
  phase1)  check_phase1 ;;
  phase2)  check_phase2 ;;
  phase3)  check_phase3 ;;
  phase4)  check_phase4 ;;
  phase5)  check_phase5 ;;
  phase6)  check_phase6 ;;
  phase7)  check_phase7 ;;
  all)     check_prereqs; check_phase1; check_phase2; check_phase3; check_phase4; check_phase5; check_phase6; check_phase7 ;;
  *)       echo "unknown section: $section"; exit 2 ;;
esac

printf '\n%s passed, %s failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
