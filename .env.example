# Maya — environment shape. Copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is gitignored and never committed. This file carries shape only:
# every value below is a placeholder, not a working secret. Generate real
# ones with the openssl command noted above each key.

# ---------------------------------------------------------------- secrets
# LibreChat credential encryption. Rotating these makes every stored
# credential unreadable, so generate once and leave alone.
#   openssl rand -hex 32
CREDS_KEY=<64 hex chars>
#   openssl rand -hex 16
CREDS_IV=<32 hex chars>

# Session signing. Rotating these logs everyone out; nothing else breaks.
#   openssl rand -hex 32
JWT_SECRET=<64 hex chars>
#   openssl rand -hex 32
JWT_REFRESH_SECRET=<64 hex chars>

# ------------------------------------------------------------ registration
# Closed. Maya is a single-user stack, and Phase 2 puts this UI on the
# tailnet — an open signup form on a reachable host is what
# FT-phase-2-remote-access exists to prevent.
#
# On a fresh install there is no account yet, so you need one pass with
# registration open:
#
#   1. set ALLOW_REGISTRATION=true in .env (this file is only the shape)
#   2. scripts/maya up, then sign up at http://127.0.0.1:3080
#   3. set it back to false and run `scripts/maya up`
#
# Note `up`, not `restart`: docker compose restart reuses the container's
# existing environment, so a changed .env has no effect until the
# container is recreated. This is silent — registration stays open and
# nothing warns you.
#
# Same three steps to add a second account later. Existing accounts are
# unaffected by this flag — it gates signup, not login.
ALLOW_REGISTRATION=false
ALLOW_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false

# ------------------------------------------------------------- endpoints
# Ollama ignores this entirely — it authenticates nothing — but the
# OpenAI-compatible client requires the field to be set. It lives here so
# that config/librechat/librechat.yaml stays free of anything key-shaped.
# Any non-empty string works.
OLLAMA_API_KEY=ollama

# ------------------------------------------------------------------ edge
# The address Caddy publishes on: this machine's Tailscale IP, so Maya is
# reachable from the tailnet and from nothing else. Find it with
# `tailscale ip -4`. Never 0.0.0.0, and never the LAN address.
TAILSCALE_IP=100.64.0.1

# The URL Maya answers on, used by LibreChat to build absolute links and
# set cookies. Its MagicDNS name — `tailscale status --json` reports it
# under CertDomains, and it must match the certificate Caddy serves.
MAYA_PUBLIC_URL=https://your-host.your-tailnet.ts.net

# --------------------------------------------------------------- gateway
# Authenticates callers to LiteLLM. Every consumer of a model presents
# it, so rotating it means restarting them all.
#   openssl rand -hex 24    (prefix the result with sk-)
LITELLM_MASTER_KEY=sk-<48 hex chars>

